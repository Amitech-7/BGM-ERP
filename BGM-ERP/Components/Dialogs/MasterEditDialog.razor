@using BGM_ERP.Services
@inject ThemeService ThemeService

<style>
    .dialog-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-dialog {
        background: var(--light-surface);
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        width: 90%;
        max-width: 700px;
        max-height: 90vh;
        overflow-y: auto;
        animation: slideIn 0.3s ease;
    }

    body.dark-theme .modal-dialog {
        background: var(--dark-surface);
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .modal-header {
        padding: 20px;
        border-bottom: 1px solid var(--light-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    body.dark-theme .modal-header {
        border-bottom-color: var(--dark-border);
    }

    .modal-header h4 {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: var(--light-text);
        padding: 0;
    }

    body.dark-theme .modal-close {
        color: var(--dark-text);
    }

    .modal-close:hover {
        opacity: 0.7;
    }

    .tabs-container {
        display: flex;
        border-bottom: 2px solid var(--light-border);
        background: var(--light-sidebar);
        padding: 0 20px;
    }

    body.dark-theme .tabs-container {
        background: var(--dark-sidebar);
        border-bottom-color: var(--dark-border);
    }

    .tab-button {
        background: none;
        border: none;
        padding: 15px 20px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        color: var(--light-text-secondary);
        border-bottom: 3px solid transparent;
        transition: all 0.3s ease;
        margin-bottom: -2px;
    }

    body.dark-theme .tab-button {
        color: var(--dark-text-secondary);
    }

    .tab-button:hover {
        color: var(--primary-color);
    }

    .tab-button.active {
        color: var(--primary-color);
        border-bottom-color: var(--primary-color);
    }

    .modal-body {
        padding: 20px;
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .form-section {
        margin-bottom: 25px;
    }

    .form-section-title {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--light-text-secondary);
        margin-bottom: 15px;
        letter-spacing: 0.8px;
    }

    body.dark-theme .form-section-title {
        color: var(--dark-text-secondary);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-bottom: 15px;
    }

    .form-row.full {
        grid-template-columns: 1fr;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 6px;
        color: var(--light-text);
    }

    body.dark-theme .form-label {
        color: var(--dark-text);
    }

    input[type="text"],
    input[type="email"],
    input[type="phone"],
    input[type="number"],
    select,
    textarea {
        padding: 10px 12px;
        border: 1px solid var(--light-border);
        border-radius: 4px;
        background: var(--light-surface);
        color: var(--light-text);
        font-size: 14px;
        font-family: inherit;
        transition: border-color 0.3s ease;
    }

    body.dark-theme input[type="text"],
    body.dark-theme input[type="email"],
    body.dark-theme input[type="phone"],
    body.dark-theme input[type="number"],
    body.dark-theme select,
    body.dark-theme textarea {
        background: var(--dark-surface);
        color: var(--dark-text);
        border-color: var(--dark-border);
    }

    input:focus,
    select:focus,
    textarea:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(30, 102, 200, 0.1);
    }

    textarea {
        resize: vertical;
        min-height: 100px;
    }

    .modal-footer {
        padding: 20px;
        border-top: 1px solid var(--light-border);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    body.dark-theme .modal-footer {
        border-top-color: var(--dark-border);
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: var(--primary-color);
        color: white;
    }

    .btn-primary:hover {
        background: var(--primary-hover);
        box-shadow: 0 4px 12px rgba(30, 102, 200, 0.3);
    }

    .btn-secondary {
        background: var(--light-border);
        color: var(--light-text);
    }

    body.dark-theme .btn-secondary {
        background: var(--dark-border);
        color: var(--dark-text);
    }

    .btn-secondary:hover {
        background: var(--light-hover);
    }

    body.dark-theme .btn-secondary:hover {
        background: var(--dark-hover);
    }

    @@media (max-width: 600px) {
        .modal-dialog {
            width: 95%;
            max-width: 95%;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .tabs-container {
            overflow-x: auto;
        }

        .tab-button {
            padding: 12px 15px;
            font-size: 13px;
        }
    }
</style>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Title { get; set; } = "Edit Master";

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string activeTab = "basic";
    private Dictionary<string, RenderFragment> tabs = new();

    protected override void OnInitialized()
    {
        // Define tabs
        tabs["basic"] = @<text>
            <div class="form-section">
                <div class="form-section-title">Basic Information</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Name *</label>
                        <input type="text" placeholder="Enter name" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Code</label>
                        <input type="text" placeholder="Enter code" />
                    </div>
                </div>
                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <textarea placeholder="Enter description"></textarea>
                    </div>
                </div>
            </div>
        </text>;

        tabs["contact"] = @<text>
            <div class="form-section">
                <div class="form-section-title">Contact Information</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" placeholder="Enter email" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone</label>
                        <input type="text" placeholder="Enter phone" />
                    </div>
                </div>
                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label">Address</label>
                        <textarea placeholder="Enter address"></textarea>
                    </div>
                </div>
            </div>
        </text>;

        tabs["documents"] = @<text>
            <div class="form-section">
                <div class="form-section-title">Documents & Details</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Registration Number</label>
                        <input type="text" placeholder="Enter registration number" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tax ID</label>
                        <input type="text" placeholder="Enter tax ID" />
                    </div>
                </div>
                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label">Notes</label>
                        <textarea placeholder="Enter notes"></textarea>
                    </div>
                </div>
            </div>
        </text>;
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task SaveForm()
    {
        await OnSave.InvokeAsync();
    }

    private async Task CancelForm()
    {
        await OnCancel.InvokeAsync();
    }
}
