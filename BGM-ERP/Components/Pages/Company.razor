@page "/masters/company"
@using BGM_ERP.Services

<div class="container-fluid">
    <div class="card">
        <div class="card-header flex-gap-10 justify-between">
            <h5 class="card-title">Companies</h5>
            <button @onclick="OpenAddDialog" class="btn btn-primary btn-sm">
                ➕ New Company
            </button>
        </div>
        <div class="card-body">
            <!-- Search and Filter Bar -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <input type="text" 
                           class="form-control" 
                           placeholder="Search company name..." 
                           @bind="searchText"
                           @oninput="OnSearchChanged" />
                </div>
                <div class="col-md-4">
                    <select class="form-control" @bind="sortBy">
                        <option value="name">Sort by Name</option>
                        <option value="city">Sort by City</option>
                        <option value="date">Sort by Date</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-secondary btn-sm" style="width: 100%;">
                        📊 Export to Excel
                    </button>
                </div>
            </div>

            <!-- Companies Table -->
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Company Name</th>
                            <th>Address</th>
                            <th>City</th>
                            <th>GST</th>
                            <th>TAN</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var company in filteredCompanies)
                        {
                            <tr>
                                <td>@company.Name</td>
                                <td>@company.Address</td>
                                <td>@company.City</td>
                                <td>@company.GST</td>
                                <td>@company.TAN</td>
                                <td>
                                    <span class="badge @(company.IsActive ? "badge-success" : "badge-error")">
                                        @(company.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm" @onclick="() => EditCompany(company)" style="background: none; border: none; color: #1E66C8; cursor: pointer;">
                                        ✏️ Edit
                                    </button>
                                    <button class="btn btn-sm" @onclick="() => DeleteCompany(company.Id)" style="background: none; border: none; color: #F44336; cursor: pointer;">
                                        🗑️ Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (filteredCompanies.Count == 0)
                {
                    <p class="text-center text-muted mt-3">No companies found</p>
                }
            </div>

            <!-- Pagination -->
            <div class="mt-3 text-center">
                <p class="text-muted">Showing @filteredCompanies.Count companies</p>
            </div>
        </div>
    </div>

    <!-- Company Dialog -->
    @if (showDialog)
    {
        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
            <div style="background: var(--light-surface); border-radius: 8px; padding: 30px; max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto;">
                <h4>@(editingCompany != null ? "Edit Company" : "New Company")</h4>

                <div class="form-group mt-3">
                    <label class="form-label">Company Name *</label>
                    <input type="text" class="form-control" @bind="editingCompany.Name" placeholder="Enter company name" />
                </div>

                <div class="form-group">
                    <label class="form-label">Address</label>
                    <input type="text" class="form-control" @bind="editingCompany.Address" placeholder="Enter address" />
                </div>

                <div class="form-group">
                    <label class="form-label">City</label>
                    <input type="text" class="form-control" @bind="editingCompany.City" placeholder="Enter city" />
                </div>

                <div class="form-group">
                    <label class="form-label">GST Number</label>
                    <input type="text" class="form-control" @bind="editingCompany.GST" placeholder="Enter GST" />
                </div>

                <div class="form-group">
                    <label class="form-label">TAN Number</label>
                    <input type="text" class="form-control" @bind="editingCompany.TAN" placeholder="Enter TAN" />
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" @bind="editingCompany.IsActive" />
                        Active
                    </label>
                </div>

                <div class="flex-gap-10" style="margin-top: 20px;">
                    <button class="btn btn-primary" @onclick="SaveCompany">Save</button>
                    <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CompanyModel> companies = new();
    private List<CompanyModel> filteredCompanies = new();
    private CompanyModel editingCompany;
    private bool showDialog = false;
    private string searchText = "";
    private string sortBy = "name";

    protected override void OnInitialized()
    {
        // Mock data
        companies = new()
        {
            new() { Id = 1, Name = "Acme Minerals", Address = "123 Main St", City = "Mumbai", GST = "GST123", TAN = "TAN123", IsActive = true },
            new() { Id = 2, Name = "Global Trade", Address = "456 Park Ave", City = "Delhi", GST = "GST456", TAN = "TAN456", IsActive = true },
            new() { Id = 3, Name = "Prime Resources", Address = "789 Bank St", City = "Bangalore", GST = "GST789", TAN = "TAN789", IsActive = false },
        };
        FilterCompanies();
    }

    private void FilterCompanies()
    {
        filteredCompanies = companies
            .Where(c => c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => sortBy == "name" ? c.Name : sortBy == "city" ? c.City : c.Id.ToString())
            .ToList();
    }

    private void OnSearchChanged()
    {
        FilterCompanies();
    }

    private void OpenAddDialog()
    {
        editingCompany = new();
        showDialog = true;
    }

    private void EditCompany(CompanyModel company)
    {
        editingCompany = new() { Id = company.Id, Name = company.Name, Address = company.Address, City = company.City, GST = company.GST, TAN = company.TAN, IsActive = company.IsActive };
        showDialog = true;
    }

    private void SaveCompany()
    {
        if (editingCompany.Id == 0)
        {
            editingCompany.Id = companies.Max(c => c.Id) + 1;
            companies.Add(editingCompany);
        }
        else
        {
            var existing = companies.FirstOrDefault(c => c.Id == editingCompany.Id);
            if (existing != null)
            {
                existing.Name = editingCompany.Name;
                existing.Address = editingCompany.Address;
                existing.City = editingCompany.City;
                existing.GST = editingCompany.GST;
                existing.TAN = editingCompany.TAN;
                existing.IsActive = editingCompany.IsActive;
            }
        }
        FilterCompanies();
        CloseDialog();
    }

    private void DeleteCompany(int id)
    {
        companies.RemoveAll(c => c.Id == id);
        FilterCompanies();
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingCompany = null;
    }

    public class CompanyModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Address { get; set; } = "";
        public string City { get; set; } = "";
        public string GST { get; set; } = "";
        public string TAN { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }
}
